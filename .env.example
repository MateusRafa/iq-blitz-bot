# Copie para variaveis do Railway (nao commitar SSID real).
# DEMO only enquanto validamos.

POCKET_OPTION_SSID=42["auth",{"session":"SEU_SESSION","isDemo":1,"uid":0,"platform":2}]
POCKET_ASSET=AUDCHF_otc
POCKET_INITIAL_DURATION=60
POCKET_BUFFER=0.30
POCKET_TARGET_PAYOUT=0.92
POCKET_AUTO_ASSET=1
POCKET_OTC_ONLY=1
POCKET_ADJUST_COOLDOWN=8
POCKET_PREPLACE_LIMIT=0
POCKET_PREPLACE_SUSTAIN=0
POCKET_USE_LIMIT=0
POCKET_TICK_SECONDS=0.05
POCKET_LOG_EVERY=5
POCKET_BASE_STAKE=1.0
POCKET_MIN_STAKE=1.0
POCKET_MAX_STAKE=50.0
POCKET_MAX_LEVELS=8
POCKET_REPAIR_LEVEL_BONUS=4
POCKET_PROFIT_GUARD=1
POCKET_DAILY_LOSS=20.0
POCKET_MIN_PAYOUT=50
POCKET_FEED_STALE_SECONDS=45
POCKET_RECONNECT_MAX=30

# Railway / portal web
CONTROL_TOKEN=troque-por-um-segredo-forte
PYTHONPATH=.
PYTHONUNBUFFERED=1

# Coletor OHLC (ferramenta /ohlc) — Supabase
# Rode sql/ohlc_candles.sql no SQL Editor do projeto.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# (alternativa) SUPABASE_SERVICE_KEY=eyJ...
OHLC_ASSET=EURUSD_otc
# Coleta alinhada a cada hora UTC (padrao). Margem apos virada da hora.
OHLC_ALIGN_HOUR=1
OHLC_AFTER_HOUR_SECONDS=120
# Se OHLC_ALIGN_HOUR=0, usa este intervalo (segundos):
OHLC_POLL_SECONDS=3600
OHLC_CONNECT_WAIT=5

# Coletor OHLC diario (ferramenta /ohlc-1d) — tabela ohlc_candles_1d
# Rode sql/ohlc_candles_1d.sql no SQL Editor.
OHLC_1D_ASSET=EURUSD_otc
# Puxa D1 nativo da Pocket (period=86400). Fallback: agrega 1h se vazio.
# Sync automatico todo dia as 00:05 horario Pocket (UTC-3 → POCKET_TIME_OFFSET=-10800).
OHLC_1D_SYNC_HOUR=0
OHLC_1D_SYNC_MINUTE=5
# Backfill inicial: quantos dias pedir a API (default ~10 anos; grava o que vier).
OHLC_1D_BACKFILL_DAYS=3650
# So grava dias ja fechados (exclui o dia civil atual no fuso Pocket).
OHLC_1D_CLOSED_ONLY=1
# Timeout da puxada D1
OHLC_1D_API_TIMEOUT=120
# Offset do relogio Pocket em segundos (UTC + offset = horario Pocket).
# UTC-3 (como na UI): -10800
POCKET_TIME_OFFSET=-10800

# Spread OTC × EURUSD (ferramenta /ohlc-spread) — tabela ohlc_candles_eurusd
# Rode sql/ohlc_candles_eurusd.sql no SQL Editor.
OHLC_EURUSD_ASSET=EURUSD
OHLC_SPREAD_OTC_ASSET=EURUSD_otc
# Sync horario (igual ao coletor 1h OTC) — coleta continua Pocket opcional
OHLC_EURUSD_ALIGN_HOUR=1
OHLC_EURUSD_AFTER_HOUR_SECONDS=120
# Buraco minimo legado (abertura agora = 1a vela do dia civil Pocket)
OHLC_SPREAD_OPEN_GAP_HOURS=2
# Dias de historico Dukascopy no botao Sincronizar / Baixar (1–90)
OHLC_SPREAD_SYNC_DAYS=14
# Janela curta do ciclo horario do coletor Dukascopy
OHLC_EURUSD_LIVE_DAYS=2
# Aguarda bi5 apos virar a hora (segundos)
OHLC_EURUSD_AFTER_HOUR_SECONDS=180
# Dukascopy datafeed (bi5 → 1h UTC Bid); sem API key
DUKASCOPY_SYMBOL=EURUSD
DUKASCOPY_WORKERS=6
DUKASCOPY_TIMEOUT=25
DUKASCOPY_RETRIES=3
# Fatias HTTP para nao estourar timeout no Railway
DUKASCOPY_CHUNK_HOURS=72
